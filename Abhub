-- ===== [3] BOUCLE PRINCIPALE DE SCAN =====
local function startScanner()
    while true do
        for _, server in ipairs(DarkGPT.SERVERS_TO_SCAN) do
            local isBrainrot, score = isBrainrotServer(server)
            if isBrainrot then
                local coords = getNextBaseCoords(server)
                sendNotification(server, coords)
                autoJoin(server) -- Désactive en mode test
                break -- Quitte la boucle après 1 détection (optionnel)
            end
        end
        os.execute("sleep " .. DarkGPT.SCAN_INTERVAL) -- Attend X secondes
    end
end

