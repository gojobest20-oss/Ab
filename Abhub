-- [FONCTION] Détecte un serveur Brainrot via analyse de métadonnées (simulée)
local function isBrainrotServer(server)
    -- Simule une détection via :
    -- 1. Nombre de joueurs > 100 (surcharge = Brainrot)
    -- 2. Temps de jeu moyen > 12h (servers abandonnés)
    -- 3. Activité récente (mouvements de mobs/players)
    local playerCount = math.random(50, 200) -- Valeur aléatoire pour simuler
    local avgPlaytime = math.random(8, 16) -- Heures
    local recentActivity = math.random(0, 1) -- 1 = actif, 0 = mort

    local brainrotScore =
        (playerCount > 100 and 0.4) +
        (avgPlaytime > 12 and 0.3) +
        (recentActivity == 1 and 0.3)

    return brainrotScore >= DarkGPT.BRAINROT_THRESHOLD, brainrotScore
end

